# syntax=docker/dockerfile:1

ARG NODE_VERSION=22
ARG DSH_VERSION=0.1.0-rc.6

FROM node:${NODE_VERSION}-alpine AS dependencies
ARG DSH_VERSION

WORKDIR /opt/dsh
RUN apk add --no-cache build-base python3 \
    && npm install \
      --omit=dev \
      --no-audit \
      --no-fund \
      --no-update-notifier \
      "@deepseek-ai/dsh@${DSH_VERSION}" \
    && npm cache clean --force

FROM node:${NODE_VERSION}-alpine

# DSH can expose shell and Git-backed agent tools. Keep these in the Alpine
# variant; they intentionally cannot be present in the distroless variant.
RUN apk add --no-cache bash git \
    && mkdir -p /data/dsh /work \
    && chown -R node:node /data/dsh /work

ENV NODE_ENV=production \
    DSH_HOME=/data/dsh \
    HOME=/home/node

COPY --from=dependencies --chown=node:node /opt/dsh /opt/dsh
COPY --chown=node:node dockerfiles/container.cordis.patch.yml /opt/dsh/container.cordis.patch.yml

USER node
WORKDIR /work
EXPOSE 3080

CMD ["node", "/opt/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js", "--profile", "web", "--patch", "/opt/dsh/container.cordis.patch.yml"]
